@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject CouncilClient Client
@using System.Globalization
@using Markdig

<PageTitle>Agent Council</PageTitle>

<div class="council">
    <header class="council-header">
        <div class="crest">⚖️</div>
        <h1>The Agent Council</h1>
        <p @key="Subtitle" class="subtitle">@Subtitle</p>
    </header>

    @if (!_started && _step == 0)
    {
        <div class="step" @key="0">
            <div class="table-stage @(_touched ? "touched" : "") @(Benched > 0 ? "has-bench" : "")">
                <div class="round-table"></div>
                <div class="table-center">
                    <span class="table-count">@_selected.Count</span>
                    <span class="table-label">seated</span>
                </div>
                <div class="seat-token you" style="--x:0px; --y:@(TableCy + TableRy)px">
                    <span class="token-icon">👑</span>
                    <span class="token-plate">You</span>
                </div>
                @foreach (var m in Members.Values.Where(x => x.Name != "You"))
                {
                    var (x, y, seated) = Spot(m.Name);
                    var t = Tuning(m.Name);
                    <button @key="m.Name" type="button" class="seat-token @m.Css @(seated ? "seated" : "waiting")"
                            style="--x:@(F(x))px; --y:@(F(y))px; --gauge:@(F(Gauge(t)))%"
                            aria-pressed="@(seated ? "true" : "false")"
                            title="@(seated ? $"Send the {m.Name} home" : $"Invite the {m.Name} to the table")"
                            @onclick="() => Toggle(m.Name)">
                        <span class="token-ring" aria-hidden="true"></span>
                        <span class="token-icon" aria-hidden="true">@m.Icon</span>
                        <span class="token-plate">@m.Name</span>
                        <span class="token-budget" aria-hidden="true">@t.MaxOutputTokens @Bolts(t.Effort)</span>
                    </button>
                }
                <p class="bench-label @(Benched > 0 ? "" : "empty")">tap to seat them</p>
            </div>

            <div class="tuning @(_selected.Count == 0 ? "hidden" : "")">
                @foreach (var m in Members.Values.Where(x => _selected.Contains(x.Name)))
                {
                    var t = Tuning(m.Name);
                    <div @key="m.Name" class="tuning-row @m.Css">
                        <div class="tuning-who">
                            <span class="tuning-name">@m.Icon @m.Name</span>
                            <span class="tuning-quote">“@m.Quote”</span>
                        </div>
                        <label class="tuning-budget">
                            <span class="tuning-cap">Token budget <b>@t.MaxOutputTokens</b> <em>· @Shape(t)</em></span>
                            <input type="range" min="150" max="1500" step="50" value="@t.MaxOutputTokens"
                                   aria-label="@m.Name token budget per turn"
                                   @oninput="e => SetBudget(m.Name, e.Value)" />
                        </label>
                        <div class="tuning-effort" role="group" aria-label="@m.Name reasoning effort">
                            @foreach (var (value, label) in Efforts)
                            {
                                <button type="button" class="effort-chip @(t.Effort == value ? "on" : "")"
                                        title="Reasoning effort: @value" @onclick="() => SetEffort(m.Name, value)">@label</button>
                            }
                        </div>
                    </div>
                }
                <p class="hint">Budget caps each turn's output tokens and sets how long a turn may be. Effort is only honoured by reasoning deployments; <em>auto</em> sends nothing.</p>
            </div>

            <div class="step-actions">
                <span class="hint">@PartyHint</span>
                <button class="btn" disabled="@(!PartyOk)" @onclick="() => _step = 1">Next: pick a topic</button>
            </div>
        </div>
    }
    else if (!_started)
    {
        <div class="step" @key="1">
            <div class="party">
                @foreach (var (m, i) in Invited.Select((x, n) => (Meta(x), n)))
                {
                    <span class="party-member @m.Css" style="--i:@i" title="@m.Title, @m.Role">@m.Icon</span>
                }
                <button type="button" class="link-btn" @onclick="() => _step = 0">Change company</button>
            </div>

            <div class="mode-row">
                <button type="button" class="mode-card @(!_groupChat ? "selected" : "")" @onclick="() => _groupChat = false">
                    <span class="mode-name">🤝 Handoff</span>
                    <span class="mode-desc">Moderator decides who speaks next and when to ask you.</span>
                </button>
                <button type="button" class="mode-card @(_groupChat ? "selected" : "")" @onclick="() => _groupChat = true">
                    <span class="mode-name">🔄 Group chat</span>
                    <span class="mode-desc">Round-robin: everyone gets the floor a fixed number of times.</span>
                </button>
            </div>

            @if (!_groupChat && !_selected.Contains("Moderator"))
            {
                <p class="hint">Moderator joins to chair the handoff.</p>
            }

            @if (_groupChat)
            {
                <label class="rounds-row">
                    Turns per agent
                    <input type="number" min="1" max="@MaxRounds" @bind="_rounds" class="rounds-input" />
                </label>
            }

            @if (Records.Any())
            {
                <label class="rounds-row">
                    📄 Resume from
                    <select @bind="_resumeFrom" class="rounds-input resume-select">
                        <option value="">— a fresh debate —</option>
                        @foreach (var f in Records)
                        {
                            <option value="@f">@f</option>
                        }
                    </select>
                </label>
            }

            <div class="topic-box">
                <input @bind="_topic" @bind:event="oninput" @onkeydown="OnTopicKeyDown"
                       placeholder="@(!Resuming ? "e.g. Should we adopt a 4-day work week?" : "What should they pick up on? (optional)")"
                       class="topic-input" />
                <button class="btn" disabled="@(!CanStart)" @onclick="StartAsync">
                    Convene the council
                </button>
            </div>
            @if (!LineupOk)
            {
                <p class="hint">Group chat needs at least two. Change company to add someone.</p>
            }
            @if (!Client.IsConnected)
            {
                <p class="hint">Connecting to the council…</p>
            }
            @if (_error is not null)
            {
                <p class="hint">⚠️ @_error</p>
            }
        </div>
    }
    else
    {
        <div class="session">
        <aside class="stage-rail">
            <div class="stage">
                <div class="stage-track"></div>
                @foreach (var (m, i) in Seats.Select((x, n) => (x, n)))
                {
                    <div @key="m.Name" class="seat @m.Css @(m.Name == _activeAgent ? "active" : "")" style="--i:@i">
                        <div class="seat-avatar">@m.Icon</div>
                        <div class="seat-name">@m.Title</div>
                    </div>
                }
                <div class="orb @(_activeAgent is null ? "" : "visible")" style="@OrbStyle()"></div>
            </div>
            <p class="stage-caption">
                <span class="chips">
                    <span class="mode-badge">@(_groupChat ? $"🔄 Group chat · {_rounds} turn(s) each" : "🤝 Handoff")</span>
                    <span class="mode-badge harness-mode @_mode" title="The Pragmatist's operating mode">@(_mode == "execute" ? "⚙️" : "📝") @_mode</span>
                    @if (_researching > 0)
                    {
                        <span class="mode-badge researching" title="Background tasks the Researcher is working on">🔎 researching · @_researching</span>
                    }
                </span>
                @if (_approval is not null)
                {
                    <span class="floor-note">🔐 Waiting for your approval</span>
                }
                else if (_activeAgent is not null and not "You")
                {
                    <span class="floor-note">@Meta(_activeAgent).Icon @Meta(_activeAgent).Title has the floor — @Meta(_activeAgent).Role</span>
                }
                else if (_awaitingUser)
                {
                    <span class="floor-note">🎙️ The floor is yours</span>
                }
            </p>

            @if (_todos.Length > 0)
            {
                <section class="rail-panel">
                    <h2>🗒️ Pragmatist's todos</h2>
                    <ul class="todo-list">
                        @foreach (var t in _todos)
                        {
                            <li class="@(t.Done ? "done" : "")"><span aria-hidden="true">@(t.Done ? "☑" : "☐")</span> @t.Title</li>
                        }
                    </ul>
                </section>
            }

            <section class="rail-panel">
                <h2>📁 Workspace</h2>
                @if (_files.Length == 0)
                {
                    <p class="hint">No files yet. Ask the Pragmatist to act.</p>
                }
                else
                {
                    <ul class="file-list">
                        @foreach (var f in _files)
                        {
                            <li>
                                <button type="button" @onclick="() => OpenFileAsync(f)">📄 @f</button>
                                <button type="button" class="file-delete" title="Delete @f" aria-label="Delete @f"
                                        @onclick="() => DeleteFile(f)">✕</button>
                            </li>
                        }
                    </ul>
                }
            </section>
        </aside>

        <div class="session-main">
        <div class="transcript">
            @for (var i = 0; i < _transcript.Count; i++)
            {
                var entry = _transcript[i];
                var m = Meta(entry.Agent);
                var streaming = _busy && i == _transcript.Count - 1 && entry.Agent != "You";
                <div class="msg @m.Css @(entry.Agent == "You" ? "from-you" : "") @(streaming ? "streaming" : "")">
                    <div class="avatar" title="@m.Role">@m.Icon</div>
                    <div class="msg-body">
                        <div class="msg-header">
                            <span class="speaker">@m.Title</span>
                            <span class="role-chip">@m.Role</span>
                        </div>
                        <div class="text">@Render(entry.Text)</div>
                    </div>
                </div>
            }
            @if (_busy && (_transcript.Count == 0 || _transcript[^1].Agent == "You"))
            {
                <div class="thinking"><span class="dot"></span><span class="dot"></span><span class="dot"></span> The council is deliberating…</div>
            }
        </div>

        @if (_error is not null)
        {
            <div class="error">⚠️ @_error</div>
        }

        @if (PlanAwaitingConfirm)
        {
            <div class="plan-bar">
                <span>📝 Master Anvil planned @_todos.Count(t => !t.Done) todo(s). Confirm to let him write, or type changes below and press <strong>🔨 Master Anvil, act</strong>.</span>
                <button class="btn" @onclick="ConfirmPlanAsync">✅ Confirm plan</button>
            </div>
        }

        <div class="reply-box">
            <input @bind="_reply" @bind:event="oninput" @onkeydown="OnReplyKeyDown"
                   placeholder="@(_awaitingUser ? "Reply to the council, or tell the Pragmatist what to build…" : "Waiting for the council…")"
                   class="reply-input" disabled="@(!_awaitingUser)" />
            <button class="btn" disabled="@(!_awaitingUser || string.IsNullOrWhiteSpace(_reply))" @onclick="ReplyAsync">
                Send ➤
            </button>
            <button class="btn secondary" disabled="@(!_awaitingUser)" @onclick="ActAsync"
                    title="The Pragmatist plans, writes files to the workspace (you approve each write) and can dispatch a Researcher.">
                🔨 Master Anvil, act
            </button>
        </div>
        </div>
        </div>
    }

    @if (_approval is not null)
    {
        <div class="modal-backdrop">
            <div class="modal" role="dialog" aria-modal="true" aria-labelledby="approval-title">
                <h2 id="approval-title">🔐 @Meta(_approval.Agent).Title wants to run <code>@_approval.Tool</code></h2>
                @if (!string.IsNullOrEmpty(_approval.Arguments))
                {
                    <pre>@_approval.Arguments</pre>
                }
                <div class="modal-actions">
                    <button class="btn danger" @onclick="@(() => RespondAsync("deny"))">Deny</button>
                    <button class="btn secondary" @onclick="@(() => RespondAsync("always"))" title="Approve, and don't ask again for this tool in this session">Always approve</button>
                    <button class="btn" @onclick="@(() => RespondAsync("approve"))">Approve</button>
                </div>
            </div>
        </div>
    }

    @if (_preview is { } preview)
    {
        <div class="modal-backdrop" @onclick="ClosePreview">
            <div class="modal wide" role="dialog" aria-modal="true" aria-labelledby="preview-title" @onclick:stopPropagation="true">
                <h2 id="preview-title">📄 @preview.Path</h2>
                <div class="text">@Render(preview.Content)</div>
                <div class="modal-actions">
                    <button class="btn" @onclick="ClosePreview">Close</button>
                </div>
            </div>
        </div>
    }

    @if (_pendingDelete is { } doomed)
    {
        <div class="modal-backdrop" @onclick="CancelDelete">
            <div class="modal" role="dialog" aria-modal="true" aria-labelledby="delete-title" @onclick:stopPropagation="true">
                <h2 id="delete-title">🗑️ Delete <code>@doomed</code>?</h2>
                <p class="hint">It is removed from the shared workspace for everyone. This can't be undone.</p>
                <div class="modal-actions">
                    <button class="btn secondary" @onclick="CancelDelete">Cancel</button>
                    <button class="btn danger" @onclick="ConfirmDeleteAsync">Delete</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // Name is the agent's key on the hub; Title is the character the UI shows.
    private sealed record Member(string Name, string Icon, string Title, string Role, string Css, string Blurb = "", string Quote = "");

    private sealed record Approval(string Agent, string Tool, string Arguments);

    // Order matters: seat positions on the stage (and the orb math) follow this order.
    private static readonly Dictionary<string, Member> Members = new()
    {
        ["Moderator"] = new("Moderator", "🛡️", "Moderator", "the Moderator", "moderator",
            "Keeps the round table civil. Mostly.", "Order! One knight at a time."),
        ["Optimist"] = new("Optimist", "🏴‍☠️", "Cap'n Sunny", "the Optimist", "optimist",
            "Sees buried treasure in every storm.", "Arr, what could possibly go wrong?"),
        ["Skeptic"] = new("Skeptic", "🧐", "Baron von Doubt", "the Skeptic", "skeptic",
            "Suspects everything. Twice.", "Fascinating. Now show me the receipts."),
        ["Pragmatist"] = new("Pragmatist", "🔨", "Master Anvil", "the Pragmatist", "pragmatist",
            "Hammers talk into actual files.", "Less talk. More anvil."),
        ["You"] = new("You", "👑", "Your Majesty", "sets the agenda", "you"),
    };

    private static readonly Member Unknown = new("Council", "🏛️", "Council", "member", "other");

    // HTML is disabled so raw markup coming back from the model is rendered as text, not injected.
    private static readonly MarkdownPipeline Markdown =
        new MarkdownPipelineBuilder().UseAdvancedExtensions().DisableHtml().Build();

    private static Member Meta(string agent) => Members.GetValueOrDefault(agent) ?? (Unknown with { Name = agent, Title = agent });

    private static MarkupString Render(string text) => (MarkupString)Markdig.Markdown.ToHtml(text, Markdown);

    // "auto" sends no reasoning option at all, which is the only safe default on a non-reasoning deployment.
    private static readonly (string Value, string Label)[] Efforts =
        [("auto", "auto"), ("low", "⚡"), ("medium", "⚡⚡"), ("high", "⚡⚡⚡")];

    // Round table geometry in px, relative to the stage's top-centre. Matches .round-table in app.css.
    private const double TableCy = 292;
    private const double TableRx = 196;
    private const double TableRy = 94;

    // The table starts empty: the whole company is waiting in the roster row to be seated.
    private readonly HashSet<string> _selected = [];
    private readonly Dictionary<string, AgentSetup> _tuning =
        Members.Keys.ToDictionary(name => name, name => new AgentSetup(name, 400, "auto"));
    private readonly HashSet<string> _seatNames = [];
    private readonly List<TranscriptEntry> _transcript = new();
    private string _topic = string.Empty;
    private string? _resumeFrom;
    private string _reply = string.Empty;
    private bool _started;
    private int _step;
    private bool _touched;
    private bool _busy;
    private bool _awaitingUser;
    private bool _groupChat;
    private const int MaxRounds = 5;
    private int _rounds = 2;
    private string? _activeAgent;
    private string? _error;
    private string _mode = "plan";
    private TodoView[] _todos = [];
    private int _researching;
    private string[] _files = [];
    private Approval? _approval;
    private (string Path, string Content)? _preview;
    private string? _pendingDelete;

    // Handoff always seats the Moderator, who owns the floor. Same rule the hub enforces.
    private List<string> Invited => Members.Keys
        .Where(n => n != "You" && ((!_groupChat && n == "Moderator") || _selected.Contains(n)))
        .ToList();

    private bool LineupOk => Invited.Count(n => n != "Moderator") >= 1 && Invited.Count >= 2;

    private bool CanStart => LineupOk && (Resuming || !string.IsNullOrWhiteSpace(_topic)) && Client.IsConnected;

    private bool Resuming => !string.IsNullOrEmpty(_resumeFrom);

    // ponytail: any markdown in the workspace counts as a record the council can pick back up.
    private IEnumerable<string> Records => _files.Where(f => f.EndsWith(".md", StringComparison.OrdinalIgnoreCase));

    private bool PartyOk => _selected.Any(n => n != "Moderator");

    private string PartyHint => PartyOk
        ? $"{_selected.Count} at the table."
        : "Pick at least one of the Optimist, Skeptic or Pragmatist.";

    private string Subtitle => _started ? "The council is in session."
        : _step == 0 ? "Who do you want to talk with?"
        : "What should they argue about?";

    private IEnumerable<Member> Seats => Members.Values.Where(m => _seatNames.Contains(m.Name));

    protected override async Task OnInitializedAsync()
    {
        Client.AgentDelta += OnAgentDelta;
        Client.AwaitUserInput += OnAwaitUserInput;
        Client.CouncilError += OnCouncilError;
        Client.ApprovalRequested += OnApprovalRequested;
        Client.HarnessState += OnHarnessState;
        Client.FilesChanged += OnFilesChanged;
        await Client.ConnectAsync();
        StateHasChanged();
    }

    private void Toggle(string name)
    {
        _touched = true;
        if (!_selected.Remove(name))
        {
            _selected.Add(name);
        }
    }

    private int Benched => Members.Count - 1 - _selected.Count(n => n != "You");

    private AgentSetup Tuning(string name) => _tuning[name];

    private void SetBudget(string name, object? raw)
    {
        if (int.TryParse(raw?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var tokens))
        {
            _tuning[name] = _tuning[name] with { MaxOutputTokens = tokens };
        }
    }

    private void SetEffort(string name, string effort) => _tuning[name] = _tuning[name] with { Effort = effort };

    private static double Gauge(AgentSetup t) => (t.MaxOutputTokens - 150) * 100.0 / (1500 - 150);

    private static string Bolts(string effort) => effort == "auto" ? string.Empty : Efforts.First(e => e.Value == effort).Label;

    // Mirrors the turn-length rule the agent is actually given (AgentSetup.Style on the hub side).
    private static string Shape(AgentSetup t) => t.MaxOutputTokens switch
    {
        <= 250 => "one punchy sentence",
        <= 700 => "two sentences",
        _ => "four sentences, with an example",
    };

    private static string F(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);

    /// <summary>
    /// Where a character stands. Uninvited ones queue in the roster row across the top; invited ones
    /// are spread around the top arc of the table below (its bottom belongs to the user), so inviting
    /// one sends it walking down to its seat. Both are plain transforms on the same element, so the
    /// whole company glides whenever the line-up changes.
    /// </summary>
    private (double X, double Y, bool Seated) Spot(string name)
    {
        var seated = Members.Keys.Where(n => n != "You" && _selected.Contains(n)).ToList();
        var index = seated.IndexOf(name);
        if (index >= 0)
        {
            // The arc opens up as the table fills: two guests sit together across from you, four spread wide.
            var arc = Math.Min(210.0, 70.0 * (seated.Count - 1));
            var degrees = seated.Count == 1 ? 0 : -arc / 2 + (arc * index / (seated.Count - 1));
            var angle = degrees * Math.PI / 180;
            return (TableRx * Math.Sin(angle), TableCy - (TableRy * Math.Cos(angle)), true);
        }

        var bench = Members.Keys.Where(n => n != "You" && !_selected.Contains(n)).ToList();
        var slot = bench.IndexOf(name);
        return ((slot - ((bench.Count - 1) / 2.0)) * 112, 52, false);
    }

    private string OrbStyle()
    {
        var seats = Seats.Select(m => m.Name).ToList();
        var index = Math.Max(0, seats.IndexOf(_activeAgent ?? string.Empty));
        // Seats are evenly spaced down the rail; the orb sits at the centre of the active one.
        return string.Create(CultureInfo.InvariantCulture,
            $"top:{(index + .5) * 100 / Math.Max(1, seats.Count):0.##}%; --orb-color:var(--{Meta(_activeAgent ?? "Moderator").Css})");
    }

    private async Task StartAsync()
    {
        if (!CanStart)
        {
            return;
        }

        var topic = _topic;
        var shown = topic;
        if (Resuming)
        {
            // The record goes in as the opening message, so the debaters and the harness both see it,
            // and the harness knows which file to update rather than writing a new one.
            if (await Client.ReadWorkspaceFileAsync(_resumeFrom!) is not { } record)
            {
                _error = $"Could not read {_resumeFrom}.";
                return;
            }

            var ask = string.IsNullOrWhiteSpace(topic) ? "Pick up where we left off: take on the open questions." : topic;
            shown = $"📄 Resuming from {_resumeFrom}\n\n{ask}";
            topic = $"We are resuming an earlier council session. Its record, workspace file `{_resumeFrom}`, reads:\n\n{record}\n\n{ask}";
        }

        _rounds = Math.Clamp(_rounds, 1, MaxRounds);
        var invited = Invited;
        _started = true;
        _seatNames.Clear();
        _seatNames.UnionWith(invited);
        _seatNames.Add("You");
        BeginTurn(shown);
        await Client.StartCouncilAsync(
            topic, _groupChat ? "groupchat" : "handoff", _rounds, invited.Select(Tuning).ToArray());
    }

    private async Task ReplyAsync()
    {
        if (string.IsNullOrWhiteSpace(_reply))
        {
            return;
        }

        var text = _reply;
        _reply = string.Empty;
        BeginTurn(text);
        await Client.SendUserInputAsync(text);
    }

    private async Task ActAsync()
    {
        var instruction = string.IsNullOrWhiteSpace(_reply)
            ? "Turn the council's debate so far into a decision record in the workspace."
            : _reply;
        _reply = string.Empty;
        BeginTurn($"🔨 {instruction}");
        await Client.AskPragmatistAsync(instruction);
    }

    // Plan mode with open todos means the Pragmatist is waiting on the user's go-ahead.
    private bool PlanAwaitingConfirm => _awaitingUser && _mode == "plan" && _todos.Any(t => !t.Done);

    private async Task ConfirmPlanAsync()
    {
        BeginTurn("✅ Plan confirmed");
        await Client.AskPragmatistAsync("Confirmed. Switch to execute mode and carry out the plan.");
    }

    private async Task RespondAsync(string decision)
    {
        _approval = null;
        _busy = true;
        _error = null;
        await Client.RespondToApprovalAsync(decision);
    }

    private void BeginTurn(string text)
    {
        _transcript.Add(new TranscriptEntry { Agent = "You", Text = text });
        _busy = true;
        _awaitingUser = false;
        _activeAgent = null;
        _error = null;
    }

    private async Task OpenFileAsync(string path)
    {
        var content = await Client.ReadWorkspaceFileAsync(path);
        _preview = (path, content ?? "_This file could not be read._");
    }

    private void DeleteFile(string path) => _pendingDelete = path;

    private void CancelDelete() => _pendingDelete = null;

    private async Task ConfirmDeleteAsync()
    {
        if (_pendingDelete is not { } path)
        {
            return;
        }

        _pendingDelete = null;
        if (_preview?.Path == path)
        {
            _preview = null;
        }

        await Client.DeleteWorkspaceFileAsync(path);
    }

    private void ClosePreview() => _preview = null;

    private async Task OnTopicKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await StartAsync();
        }
    }

    private async Task OnReplyKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _awaitingUser && !string.IsNullOrWhiteSpace(_reply))
        {
            await ReplyAsync();
        }
    }

    private void OnAgentDelta(string agent, string text)
    {
        _busy = true;
        _awaitingUser = false;
        _activeAgent = agent;
        if (Members.ContainsKey(agent))
        {
            // The Pragmatist can act even when it wasn't invited to debate; give it a seat when it does.
            _seatNames.Add(agent);
        }

        var last = _transcript.Count > 0 ? _transcript[^1] : null;
        if (last is not null && last.Agent == agent)
        {
            last.Text += text;
        }
        else
        {
            _transcript.Add(new TranscriptEntry { Agent = agent, Text = text });
        }

        InvokeAsync(StateHasChanged);
    }

    private void OnAwaitUserInput()
    {
        _busy = false;
        _awaitingUser = true;
        _activeAgent = "You";
        InvokeAsync(StateHasChanged);
    }

    private void OnCouncilError(string message)
    {
        _error = message;
        _busy = false;
        _awaitingUser = true;
        _activeAgent = "You";
        InvokeAsync(StateHasChanged);
    }

    private void OnApprovalRequested(string agent, string tool, string arguments)
    {
        _approval = new Approval(agent, tool, arguments);
        _busy = false;
        _awaitingUser = false;
        _activeAgent = agent;
        InvokeAsync(StateHasChanged);
    }

    private void OnHarnessState(string mode, TodoView[] todos, int researching)
    {
        _mode = mode;
        _todos = todos;
        _researching = researching;
        InvokeAsync(StateHasChanged);
    }

    private void OnFilesChanged(string[] files)
    {
        _files = files;
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        Client.AgentDelta -= OnAgentDelta;
        Client.AwaitUserInput -= OnAwaitUserInput;
        Client.CouncilError -= OnCouncilError;
        Client.ApprovalRequested -= OnApprovalRequested;
        Client.HarnessState -= OnHarnessState;
        Client.FilesChanged -= OnFilesChanged;
        await Client.DisposeAsync();
    }
}
